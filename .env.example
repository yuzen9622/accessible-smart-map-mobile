# 公開設定（會被內嵌進 App bundle，不得放 secret）。預設連正式環境；要連開發後端請在 .env.local（已 gitignore）設 EXPO_PUBLIC_END_POINT=https://map-dev.yuzen.dev。
EXPO_PUBLIC_END_POINT=https://map.yuzen.dev
EXPO_PUBLIC_SHARE_BASE_URL=https://map.yuzen.dev
# Phase 3 Google 登入才需要
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# 隱私權政策／服務條款（https）；留空時設定頁不顯示入口
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_TERMS_URL=
# LINE 官方帳號 basic ID（@ 開頭）；家人追蹤頁的「回 LINE 回報」入口用，未設定則不顯示
EXPO_PUBLIC_LINE_BOT_BASIC_ID=
