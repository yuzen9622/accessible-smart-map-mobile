{
  "expo": {
    "name": "無障礙智慧地圖",
    "slug": "accessible-smart-map-mobile",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "accessiblesmartmap",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/app.icon",
      "bundleIdentifier": "com.accessiblemap.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true,
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ],
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePreciseLocation",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeEmailAddress",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeName",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeUserID",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePhotosorVideos",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeOtherUserContent",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeOtherDataTypes",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeAudioData",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeSensitiveInfo",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeDeviceID",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          }
        ]
      },
      "associatedDomains": [
        "applinks:map.yuzen.dev",
        "applinks:map-dev.yuzen.dev"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#3C70FC",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.accessiblemap.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-notifications",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#3C70FC",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "./plugins/with-ios-scene-lifecycle.ts",
      "expo-localization",
      "@maplibre/maplibre-react-native",
      [
        "react-native-audio-api",
        {
          "iosMicrophonePermission": "語音助理會用麥克風把你說的話即時傳給 Google Gemini 處理並回覆你；搜尋時也能用語音輸入取代打字。The microphone lets the voice assistant send your speech to Google Gemini so it can reply, and lets you search by speaking instead of typing.",
          "iosBackgroundMode": false,
          "androidPermissions": [
            "android.permission.RECORD_AUDIO",
            "android.permission.MODIFY_AUDIO_SETTINGS"
          ],
          "androidForegroundService": false,
          "androidFSTypes": [],
          "androidFSStopWithTask": true,
          "disableFFmpeg": true,
          "disableStaticExternalLibs": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "語音助理會用麥克風把你說的話即時傳給 Google Gemini 處理並回覆你；搜尋時也能用語音輸入取代打字。The microphone lets the voice assistant send your speech to Google Gemini so it can reply, and lets you search by speaking instead of typing.",
          "speechRecognitionPermission": "搜尋時用語音輸入，會由 Apple 語音辨識把你說的話轉成文字。Speech recognition turns what you say into text when you search by voice."
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "用來在地圖上顯示你的位置、搜尋附近的無障礙設施與規劃路線。Your location is used to show nearby accessible facilities and plan routes.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "只在導航進行中或 SOS 求救期間，於背景或鎖定螢幕時持續更新你的位置，讓導航繼續播報下一步，並讓緊急聯絡人看到你的位置；其他時候不會在背景取得位置。Only during navigation or an active SOS, your location keeps updating in the background or on the lock screen so turn-by-turn guidance continues and your emergency contacts can see where you are. It is not used in the background at any other time.",
          "locationAlwaysPermission": "只在導航進行中或 SOS 求救期間，於背景或鎖定螢幕時持續更新你的位置，讓導航繼續播報下一步，並讓緊急聯絡人看到你的位置；其他時候不會在背景取得位置。Only during navigation or an active SOS, your location keeps updating in the background or on the lock screen so turn-by-turn guidance continues and your emergency contacts can see where you are. It is not used in the background at any other time.",
          "motionUsagePermission": "本 App 目前不會讀取動作與健身資料；此說明為定位元件的系統需求。若日後啟用，僅用於判斷你是否在步行中以調整導航提示。This app does not currently read motion and fitness data; this description is required by the location component. If enabled in the future, it would only be used to detect walking to adjust navigation guidance.",
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-widgets",
        {
          "frequentUpdates": true
        }
      ],
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.953122204824-3c0nbcp4s28260g2v5or2nk3455n84gf"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "回報障礙物時用相機拍攝現場照片。The camera is used to take a photo of the hazard you are reporting.",
          "photosPermission": "回報障礙物時從相簿選擇現場照片。Photos are used to attach a picture of the hazard you are reporting.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#3C70FC"
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bb9d1d34-20a9-4b56-9da0-07ebca78c153"
      }
    },
    "owner": "yuzen",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/bb9d1d34-20a9-4b56-9da0-07ebca78c153",
      "requestHeaders": {
        "expo-channel-name": "preview"
      }
    }
  }
}
