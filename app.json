{
  "expo": {
    "name": "臺北無障礙導航",
    "slug": "accessible-smart-map-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "accessiblesmartmap",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.accessiblemap.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.accessiblemap.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "./plugins/with-ios-scene-lifecycle.ts",
      "expo-localization",
      "@maplibre/maplibre-react-native",
      [
        "react-native-audio-api",
        {
          "iosMicrophonePermission": "語音助理需要使用麥克風，將你的語音即時傳給助理以回覆你。Voice assistant uses the microphone to send your speech to the assistant.",
          "iosBackgroundMode": false,
          "androidPermissions": [
            "android.permission.RECORD_AUDIO",
            "android.permission.MODIFY_AUDIO_SETTINGS"
          ],
          "androidForegroundService": false,
          "androidFSTypes": [],
          "androidFSStopWithTask": true,
          "disableFFmpeg": true,
          "disableStaticExternalLibs": false
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "用來在地圖上顯示你的位置、搜尋附近的無障礙設施與規劃路線。Your location is used to show nearby accessible facilities and plan routes.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "導航進行中切到背景或鎖定螢幕時，持續更新你的位置以播報下一步；只在導航時使用。Your location keeps updating during navigation while the app is in the background, so turn-by-turn guidance continues. Used only while navigating.",
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-widgets",
        {
          "frequentUpdates": true
        }
      ],
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "cameraPermission": "回報障礙物時用相機拍攝現場照片。The camera is used to take a photo of the hazard you are reporting.",
          "photosPermission": "回報障礙物時從相簿選擇現場照片。Photos are used to attach a picture of the hazard you are reporting.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#208AEF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bb9d1d34-20a9-4b56-9da0-07ebca78c153"
      }
    },
    "owner": "yuzen"
  }
}
