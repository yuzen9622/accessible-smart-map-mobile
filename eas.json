{
  "cli": {
    "version": ">= 24.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": { "simulator": true }
    },
    "development-device": {
      "extends": "development",
      "ios": { "simulator": false }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_END_POINT": "https://map.yuzen.dev"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_END_POINT": "https://map.yuzen.dev",
        "EXPO_PUBLIC_SHARE_BASE_URL": "https://map.yuzen.dev",
        "EXPO_PUBLIC_PRIVACY_POLICY_URL": "https://map.yuzen.dev/zh-TW/policies/privacy-policy",
        "EXPO_PUBLIC_TERMS_URL": "https://map.yuzen.dev/zh-TW/policies/terms-of-use",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "953122204824-qdgsaflqssbcij82oa2ri6dvmc1ug1ak.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "953122204824-3c0nbcp4s28260g2v5or2nk3455n84gf.apps.googleusercontent.com"
      }
    },
    "testflight-dev": {
      "extends": "production",
      "distribution": "store",
      "channel": "testflight-dev",
      "env": {
        "EXPO_PUBLIC_END_POINT": "https://map-dev.yuzen.dev",
        "EXPO_PUBLIC_SHARE_BASE_URL": "https://map-dev.yuzen.dev",
        "EXPO_PUBLIC_PRIVACY_POLICY_URL": "https://map-dev.yuzen.dev/zh-TW/policies/privacy-policy",
        "EXPO_PUBLIC_TERMS_URL": "https://map-dev.yuzen.dev/zh-TW/policies/terms-of-use",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "953122204824-qdgsaflqssbcij82oa2ri6dvmc1ug1ak.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "953122204824-3c0nbcp4s28260g2v5or2nk3455n84gf.apps.googleusercontent.com"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6820790448"
      }
    }
  }
}
