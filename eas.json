{
  "cli": {
    "version": ">= 24.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment":"development",
      "ios": { "simulator": true }
    },
    "development-device": {
      "extends": "development", "environment":"development",
      "ios": { "simulator": false }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview"
    },
    "production": {
      "ios": {
        "autoIncrement": true
      },
      "channel": "production",
      "environment": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6820790448"
      }
    },
    "testflight-dev": {
      "ios": {
        "ascAppId": "6820790448"
      }
    }
  }
}
