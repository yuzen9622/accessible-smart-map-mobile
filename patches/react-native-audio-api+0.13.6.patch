+- (void)handleConfigurationChangeIfCurrent:(BOOL (^)(AVAudioEngine *))matchesEngine
+{
+  // Called after hopping off AVAudioEngine's internal notification queue. Taking
+  // this lock on that queue can deadlock against AVAudioEngine deallocation.
+  std::scoped_lock lock(_engineLock);
+  // The predicate reads a weak notification sender while we hold the engine lock.
+  // Release temporary references before doing any graph recovery.
+  BOOL matchesCurrentEngine;
+  @autoreleasepool {
+    matchesCurrentEngine = matchesEngine(self.audioEngine);
+  }
+  if (!matchesCurrentEngine || ![self hasTrackedGraph] ||
+      [self.audioEngine isRunning]) {
+    return;
+  }
+
+  // A real I/O configuration change stops the current engine. A delayed notification
+  // from our own voice-processing setup, a replaced engine, or another audio library
+  // must not tear down a graph that is already running successfully.
+  [self.sessionManager markInactive];
+  // AVAudioEngineConfigurationChange leaves nodes connected with old hardware
+  // formats. Reconnect registrations on this engine, preserving VoiceProcessingIO:
+  // replacing that unit can itself trigger another hardware change and a loop.
+  // The implicit mainMixer -> output connection tracks hardware format on restart.
+  BOOL shouldResume = self.state == AudioEngineState::AudioEngineStateRunning;
+  [self.audioEngine stop];
+  for (AVAudioSourceNode *sourceNode in [self.sourceNodes allValues]) {
+    [self.audioEngine detachNode:sourceNode];
+  }
+  if (self.inputNode != nil) {
+    [self.audioEngine detachNode:self.inputNode];
+  }
+  [self.audioEngine reset];
+  self.sourceNodes = [[NSMutableDictionary alloc] init];
+  self.sourceFormats = [[NSMutableDictionary alloc] init];
+  self.inputNode = nil;
+  self.graphNeedsRebuild = false;
+  self.sessionDeactivationInvalidatedGraph = false;
+
+  if (![self materializeTrackedNodesIfNeeded] || (shouldResume && ![self startEngine])) {
+    self.state = AudioEngineState::AudioEngineStatePaused;
+  }
+  [self notifyConfigurationChanges];
 }

